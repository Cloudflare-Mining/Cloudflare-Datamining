	"PUT /accounts/{account_id}/firewall/payload_logging/key": {
		"operationId": "payload-logging-keys-for-an-account-set-the-payload-logging-key",
		"summary": "Set the payload logging key",
		"description": "Creates or replaces the public key that payload logging uses to encrypt matched payloads for the account. It applies to every zone in the account that has no zone key. Requires a plan that includes payload logging (Enterprise); otherwise it returns 403.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Defines an account identifier.",
					"type": "string",
					"example": "023e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"public_key": {
								"description": "Defines the X25519 public key, as standard base64 of exactly 32 bytes, that encrypts matched payloads. Cloudflare stores only the public key; keep the private key to decrypt logged payloads.",
								"type": "string",
								"example": "Ycig/Zr/pZmklmFUN99nr+taURlYItL91g+NcHGYpB8=",
								"maxLength": 44,
								"minLength": 44
							}
						},
						"required": [
							"public_key"
						]
					}
				}
			}
		},
