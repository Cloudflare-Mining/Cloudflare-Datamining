{
	"GET /accounts/{account_id}/pay-per-use/enabled-publishers": {
		"operationId": "pay-per-use.listEnabledPublishers",
		"summary": "List enabled Pay Per Use publishers",
		"description": "Returns the publishers whose offers the requesting Pay Per Use operator has accepted, one item per publisher with the domains it covers. Licensing is per publisher, and the domains are informational and do not restrict usage. Report usage with the item's publisher_id. Each item shows one accepted offer; an active offer takes precedence over an expired one. License expiration is the earlier non-null boundary from the offer and the publisher lifecycle. A future expiration remains active and is exposed to the operator. After expiration, the license remains listed as expired for one calendar month before it is omitted. Zone agreements are listed by the enabled domains endpoint instead. Items are ordered alphabetically by publisher_name, ignoring case and accents, then by publisher_id; a publisher renamed while you paginate can be skipped or listed twice. The requesting account must be an active Pay Per Use operator.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Account identifier for the participant",
				"required": true,
				"schema": {
					"type": "string"
				},
				"x-auditable": true
			},
			{
				"name": "cursor",
				"in": "query",
				"description": "Opaque, account-bound cursor returned by the previous page. Cursors expire after one hour; restart pagination without a cursor after receiving a 400 response for an expired cursor.",
				"schema": {
					"type": "string"
				}
			},
			{
				"name": "per_page",
				"in": "query",
				"description": "Maximum number of publishers to return",
				"schema": {
					"type": "integer",
					"default": 100,
					"maximum": 100,
					"minimum": 1
				}
			}
		],
		"responses": {
			"200": {
				"description": "Enabled publishers returned successfully",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"result": {
									"type": "object",
									"properties": {
										"cursor": {
											"description": "Opaque, account-bound cursor for the next page. It expires after one hour and is null on the final page.",
											"type": "string",
											"nullable": true
										},
										"publishers": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"domains": {
														"description": "Domains the publisher covers, sorted. Empty when the publisher covers no domains.",
														"type": "array",
														"items": {
															"type": "string"
														}
													},
													"license_expires_at": {
														"description": "Earlier non-null exclusive expiration from the accepted offer and the publisher lifecycle, or null when neither expires",
														"type": "string",
														"format": "date-time",
														"nullable": true
													},
													"license_status": {
														"description": "Whether the selected accepted offer is currently active or retained after expiration",
														"type": "string",
														"enum": [
															"active",
															"expired"
														]
													},
													"price_usd_microcents": {
														"description": "Price of the selected accepted offer in microcents. For an active license this is the price currently in effect; for an expired license it is the last accepted price.",
														"type": "integer",
														"format": "int64"
													},
													"publisher_id": {
														"description": "Identifier of the publisher whose accepted offer this is. Report usage for this publisher with this publisher_id.",
														"type": "string",
														"pattern": "^[0-9a-f]{32}$"
													},
													"publisher_name": {
														"description": "Display name of the publisher.",
														"type": "string"
													}
												},
												"required": [
													"publisher_id",
													"publisher_name",
													"domains",
													"license_status",
													"license_expires_at",
													"price_usd_microcents"
												]
											}
										}
									},
									"required": [
										"cursor",
										"publishers"
									]
								},
								"result_info": {
									"type": "object",
									"properties": {
										"count": {
											"type": "integer"
										},
										"page": {
											"type": "integer"
										},
										"per_page": {
											"type": "integer"
										},
										"total_count": {
											"type": "integer"
										},
										"total_pages": {
											"description": "TotalPages is a pointer so that if TotalPages == 0 we return that there\nare indeed 0 pages. omitempty would have removed the field otherwise.\nThis is important as a customer may be relying on always reading this\nproperty and it should not be absent just because it is 0, only absent\nif a value is never provided.",
											"type": "integer"
										}
									}
								},
								"success": {
									"type": "boolean"
								}
							},
							"required": [
								"success",
								"result"
							]
						}
					}
				}
			},
			"400": {
				"description": "Invalid cursor or page size",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"code": {
												"type": "integer"
											},
											"documentation_url": {
												"type": "string"
											},
											"error": {
												"type": "string"
											},
											"source": {
												"type": "object",
												"properties": {
													"pointer": {
														"type": "string"
													}
												}
											}
										}
									}
								},
								"result": {
									"type": "object",
									"nullable": true
								},
								"success": {
									"type": "boolean"
								}
							}
						}
					}
				}
			},
			"401": {
				"description": "Invalid or insufficiently scoped API token",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"code": {
												"type": "integer"
											},
											"documentation_url": {
												"type": "string"
											},
											"error": {
												"type": "string"
											},
											"source": {
												"type": "object",
												"properties": {
													"pointer": {
														"type": "string"
													}
												}
											}
										}
									}
								},
								"result": {
									"type": "object",
									"nullable": true
								},
								"success": {
									"type": "boolean"
								}
							}
						}
					}
				}
			},
			"403": {
				"description": "Account is not an active Pay Per Use operator",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"code": {
												"type": "integer"
											},
											"documentation_url": {
												"type": "string"
											},
											"error": {
												"type": "string"
											},
											"source": {
												"type": "object",
												"properties": {
													"pointer": {
														"type": "string"
													}
												}
											}
										}
									}
								},
								"result": {
									"type": "object",
									"nullable": true
								},
								"success": {
									"type": "boolean"
								}
							}
						}
					}
				}
			},
			"500": {
				"description": "Enabled publishers could not be retrieved",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"code": {
												"type": "integer"
											},
											"documentation_url": {
												"type": "string"
											},
											"error": {
												"type": "string"
											},
											"source": {
												"type": "object",
												"properties": {
													"pointer": {
														"type": "string"
													}
												}
											}
										}
									}
								},
								"result": {
									"type": "object",
									"nullable": true
								},
								"success": {
									"type": "boolean"
								}
							}
						}
					}
				}
			}
		},
		"security": [
			{
				"api_token": []
			},
			{
				"api_email": [],
				"api_key": []
			}
		],
		"tags": [
			"ppu_enabled_publishers"
		],
		"x-fern-sdk-group-name": "pay-per-use.enabled-publishers",
		"x-fern-sdk-method-name": "list",
		"x-forge-group-name": "pay-per-use.enabled-publishers",
		"x-forge-method-name": "list",
		"x-stability": "beta"
	}
}