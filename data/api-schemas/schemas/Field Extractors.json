					"example": "llm_prompts",
					"minLength": 1
				}
			}
		],
		"requestBody": {
			"description": "Desired-state replacement of all rules for this extractor type.",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"rules": {
								"type": "array",
								"items": {
									"properties": {
										"description": {
											"type": "string",
											"maxLength": 4096
										},
										"fields": {
