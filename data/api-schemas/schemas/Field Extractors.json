	"PUT /accounts/{account_id}/field_extractors/{extractor}": {
		"operationId": "updateFieldExtractor",
		"summary": "Update Field Extractor",
		"description": "Replaces all custom extraction rules for an extractor type. Omitted rules are deleted.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Cloudflare account ID.",
				"required": true,
