												"required": [
													"name",
													"expression"
												],
												"type": "object"
											},
											"minItems": 1
										},
										"ref": {
											"type": "string",
											"maxLength": 64,
											"minLength": 1,
											"pattern": "^[a-zA-Z0-9_-]+$"
										}
									},
									"required": [
										"ref",
										"fields"
									],
									"type": "object"
								},
								"maxItems": 10,
								"minItems": 1
							}
						},
						"required": [
							"rules"
