											"example": "2024-01-15T10:30:00Z",
											"readOnly": true
										},
										"value": {
											"description": "The NEL configuration value.",
											"type": "object",
											"properties": {
												"enabled": {
													"description": "Whether Network Error Logging is enabled for the zone. When enabled, browsers report network errors to Cloudflare's NEL endpoint.\n",
