			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"id": {
								"description": "The query ID to update (required when updating tag or scan)",
								"type": "integer"
							},
							"scan": {
								"description": "Whether to scan matches",
								"type": "boolean"
							},
							"string_matches": {
								"description": "Updated pattern match constraints. When provided, replaces the existing string_matches.",
								"type": "array",
								"items": {
									"properties": {
										"max_edit_distance": {
											"description": "Maximum Levenshtein edit distance for fuzzy matching",
											"type": "number"
										},
										"pattern": {
											"description": "The pattern to match against",
											"type": "string"
										}
									},
