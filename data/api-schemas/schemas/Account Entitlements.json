{
	"GET /accounts/{account_id}/entitlements": {
		"operationId": "entitlements-get-account-entitlements",
		"summary": "Get Account Entitlements",
		"description": "Returns the list of entitlements (features and their allocations) for a given account. Each entitlement describes a product feature the account is permitted to use and the allocation value (boolean, count, range, enum, or string) that governs its behaviour.\n",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Identifier of the account.",
				"required": true,
				"schema": {
					"description": "Identifier tag.",
					"type": "string",
					"example": "023e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"minLength": 32,
					"pattern": "^[0-9a-f]{32}$"
				}
			}
		],
		"responses": {
			"200": {
				"description": "List of entitlements for the account.",
				"content": {
					"application/json": {
