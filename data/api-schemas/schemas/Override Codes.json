						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"description": "A message which can be returned in either the 'errors' or 'messages' fields in a v4 API response.",
										"type": "object",
										"properties": {
											"code": {
												"type": "integer"
											},
											"message": {
												"type": "string"
											}
										},
										"required": [
											"code",
											"message"
										]
									}
								},
								"messages": {
									"type": "array",
									"items": {
