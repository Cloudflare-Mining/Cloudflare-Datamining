{
	"POST /accounts/{account_id}/devices/override_codes": {
		"operationId": "create-override-code",
		"summary": "Generate an uninstall protection override code",
		"description": "Generates an account-wide or device-specific uninstall protection override code.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				},
				"x-auditable": true
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"device_id": {
								"description": "Physical device ID. Required when scope is device and forbidden when scope is account.",
								"type": "string",
								"format": "uuid",
								"x-auditable": true
							},
							"duration_hours": {
								"description": "Number of hours for which the override code should remain valid.",
								"type": "integer",
								"maximum": 24,
								"minimum": 1,
								"x-auditable": true
							},
							"scope": {
								"description": "Whether the code applies to every device in the account or one physical device.",
								"type": "string",
								"enum": [
									"account",
									"device"
								],
								"x-auditable": true
							},
							"type": {
								"description": "The feature that the override code applies to.",
								"type": "string",
								"enum": [
									"uninstall_protection"
								],
								"x-auditable": true
							}
						},
						"required": [
							"type",
							"scope",
							"duration_hours"
						]
					}
				}
			}
		},
		"responses": {
