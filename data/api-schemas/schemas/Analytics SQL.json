{
	"GET /analytics/sql": {
		"operationId": "sql-api-query-get",
		"summary": "Query analytics datasets",
		"description": "Executes a SQL query against the analytics datasets available to the caller. SQL placeholders can be bound with query parameters named `param_<name>`, such as `param_status=404` for `$status`.\n",
		"parameters": [
			{
				"name": "query",
				"in": "query",
				"description": "SQL query to execute.",
				"required": true,
				"schema": {
					"type": "string"
				},
				"example": "SELECT edgeResponseStatus FROM events.httpRequests WHERE accountTag = '0123456789abcdef0123456789abcdef' AND datetime > '2026-01-01' LIMIT 10"
			}
		],
		"responses": {
			"200": {
				"description": "Query executed successfully.",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"data": {
									"description": "Query result rows keyed by the selected column names.",
									"type": "array",
									"items": {
										"additionalProperties": true,
										"type": "object"
									}
								},
								"rows": {
									"description": "Number of rows in `data`.",
									"type": "integer",
									"format": "int64",
									"minimum": 0
								},
								"statistics": {
									"type": "object",
									"properties": {
										"bytes_read": {
											"description": "Number of source bytes read while executing the query.",
											"type": "integer",
											"format": "int64",
											"minimum": 0
										},
										"elapsed_ms": {
											"description": "Backend execution time in milliseconds.",
											"type": "integer",
											"format": "int64",
											"minimum": 0
										},
										"rows_read": {
											"description": "Number of source rows read while executing the query.",
											"type": "integer",
											"format": "int64",
											"minimum": 0
										}
									},
									"additionalProperties": false,
									"required": [
										"elapsed_ms",
										"rows_read",
										"bytes_read"
									]
								}
							},
							"additionalProperties": false,
							"required": [
								"data",
								"rows",
								"statistics"
							]
						}
					}
				}
			},
			"400": {
				"description": "The request is malformed, or authentication was rejected by the API gateway before the request reached the SQL service.\n",
				"content": {
					"application/json": {
						"schema": {
							"oneOf": [
								{
									"type": "object",
									"properties": {
										"code": {
											"description": "Machine-readable error code.",
											"type": "integer",
											"format": "int64",
											"minimum": 0
										},
										"error_chain": {
											"description": "Additional errors that caused this error.",
											"type": "array",
