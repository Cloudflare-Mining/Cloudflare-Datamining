	"GET /analytics/sql/introspection": {
		"operationId": "sql-api-introspection",
		"summary": "List available analytics datasets",
		"description": "Returns the analytics dataset catalogue. By default, the response contains dataset names, titles, descriptions, and kinds. Set `include_columns` to include each dataset's column names, descriptions, and data types. The caller must have Account Analytics Read permission on the account identified by `account_tag`. Dataset names, descriptions, and columns are the same for every authorized account. When `include_custom_attributes` is set, the response also includes a capped set of custom attribute names and types discovered from the preceding seven days of that account's own data, which legitimately differs per caller.\n",
		"parameters": [
			{
				"name": "account_tag",
				"in": "query",
				"description": "Account whose available analytics datasets are returned.",
				"required": true,
				"schema": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"example": "0123456789abcdef0123456789abcdef"
			},
			{
				"name": "include_columns",
				"in": "query",
				"description": "Include column metadata for each returned dataset.",
				"schema": {
					"type": "boolean",
					"default": false
				}
			},
			{
				"name": "include_custom_attributes",
				"in": "query",
				"description": "Include a capped set of custom attribute names and types observed during the preceding seven days. Requires a nonempty dataset_name.\n",
				"schema": {
					"type": "boolean",
					"default": false
				}
			},
			{
				"name": "dataset_name",
				"in": "query",
				"description": "Return only the dataset with this exact name. An empty value does not filter the catalogue. An unknown name returns a successful response with an empty `datasets` array.\n",
				"schema": {
					"type": "string"
				},
				"example": "events.httpRequests"
			}
		],
		"responses": {
			"200": {
				"description": "Dataset catalogue returned successfully.",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"datasets": {
									"description": "Datasets visible through the Analytics SQL API.",
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"columns": {
												"description": "Present when `include_columns` is true.",
												"type": "array",
												"items": {
													"type": "object",
													"properties": {
														"data_type": {
															"description": "SQL data type of the column.",
															"type": "string",
															"example": "String"
														},
														"description": {
															"description": "Human-readable description of the column.",
															"type": "string"
														},
														"name": {
															"description": "Column name used in SQL queries.",
															"type": "string",
															"example": "clientRequestPath"
														}
													},
													"additionalProperties": false,
													"required": [
														"name",
														"description",
														"data_type"
													]
												}
											},
											"custom_attributes": {
												"description": "Present when `include_custom_attributes` is true and the dataset supports custom attributes.",
												"type": "array",
												"items": {
													"type": "object",
													"properties": {
														"data_type": {
															"description": "ClickHouse type of the attribute value.",
															"type": "string",
															"example": "String"
														},
														"name": {
															"description": "Attribute name.",
															"type": "string"
														}
													},
													"additionalProperties": false,
													"required": [
														"name",
														"data_type"
													]
												}
											},
											"description": {
												"description": "Human-readable description of the dataset.",
												"type": "string"
											},
											"kind": {
												"description": "What kind of dataset this is. Determines aggregation rules and sampling behavior. Exactly one of `events`, `states`, or `logs` is present.\n",
												"type": "object",
												"properties": {
													"events": {
														"description": "Row-per-event analytics dataset. Aggregations describe the cumulative effect of those events.\n",
														"type": "object",
														"additionalProperties": false,
														"properties": {
															"sampling": {
																"description": "Whether the dataset is sampled. `unsampled` means every row is recorded. `adaptive` means Adaptive Bit Rate (ABR) sampling is applied, and aggregates must be weighted accordingly.\n",
																"type": "string",
																"enum": [
																	"unsampled",
																	"adaptive"
																]
															}
														},
														"required": [
															"sampling"
														]
													},
													"logs": {
														"description": "Row-per-log dataset intended for record retrieval.",
														"type": "object",
														"additionalProperties": false,
														"properties": {
															"sampling": {
																"description": "Whether the dataset is sampled. `unsampled` means every row is recorded. `adaptive` means Adaptive Bit Rate (ABR) sampling is applied, and aggregates must be weighted accordingly.\n",
																"type": "string",
																"enum": [
																	"unsampled",
																	"adaptive"
																]
															}
														},
														"required": [
															"sampling"
														]
													},
													"states": {
														"description": "Snapshot/state dataset. Only `valid_aggregations` are valid aggregations for this dataset.\n",
														"type": "object",
														"additionalProperties": false,
														"properties": {
															"sampling": {
																"description": "Whether the dataset is sampled. `unsampled` means every row is recorded. `adaptive` means Adaptive Bit Rate (ABR) sampling is applied, and aggregates must be weighted accordingly.\n",
																"type": "string",
																"enum": [
																	"unsampled",
																	"adaptive"
																]
															},
															"valid_aggregations": {
																"description": "Which aggregation function names are allowed for this dataset.",
																"type": "array",
																"items": {
																	"type": "string"
																},
																"example": [
																	"count",
																	"max"
																]
															}
														},
														"required": [
															"sampling",
															"valid_aggregations"
														]
													}
												},
												"additionalProperties": false,
												"maxProperties": 1,
												"minProperties": 1
											},
											"name": {
												"description": "Dataset name used in SQL queries.",
												"type": "string",
												"example": "events.httpRequests"
											},
											"title": {
												"description": "Human-readable title of the dataset.",
												"type": "string",
												"example": "HTTP Requests"
											}
										},
										"additionalProperties": false,
										"required": [
											"name",
											"title",
											"description",
											"kind"
										]
									}
								}
							},
							"additionalProperties": false,
							"required": [
								"datasets"
							]
						}
					}
				}
			},
			"400": {
				"description": "The request is malformed, or authentication was rejected by the API gateway before the request reached the SQL service.\n",
				"content": {
					"application/json": {
						"schema": {
