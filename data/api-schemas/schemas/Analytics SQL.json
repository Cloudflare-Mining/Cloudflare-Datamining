											"description": "Human-readable error message.",
											"type": "string"
										}
									},
									"additionalProperties": false,
									"required": [
										"code",
										"message"
									]
								},
								{
									"type": "object",
									"properties": {
										"errors": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"code": {
														"description": "Machine-readable error code.",
														"type": "integer",
														"format": "int64",
														"minimum": 0
													},
													"error_chain": {
														"description": "Additional errors that caused this error.",
														"type": "array",
														"items": "[Circular ~.GET /analytics/sql.responses.400.content.application/json.schema.oneOf.1.properties.errors.items]"
													},
													"message": {
														"description": "Human-readable error message.",
														"type": "string"
													}
												},
												"additionalProperties": false,
												"required": [
													"code",
