												"type": "string"
											},
											"inputTokens": {
												"description": "Input tokens reported by the Session's chat spans; spans without usage are skipped, and the field is omitted when none report it.",
												"type": "number"
											},
											"lastActiveMs": {
												"description": "End of this Agent's last observed invocation in the Session, as Unix epoch milliseconds. Sessions are ordered by this value. Agent activity, not Trace end: work that continues in a Trace after the Agent returns is not included; per-run Trace times are on the Session runs endpoint.",
