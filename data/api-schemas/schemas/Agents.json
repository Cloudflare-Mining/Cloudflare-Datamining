{
	"GET /accounts/{account_id}/workers/observability/agents/sessions": {
		"operationId": "agents.sessions.list",
		"summary": "List Agent sessions",
		"description": "List the Sessions of one Agent in one Worker service observed in the window, most recently active first. A Session groups the Traces containing an invocation of the Agent with the same gen_ai.conversation.id. Results describe observed activity in the window, not complete history.",
