			{
				"name": "service",
				"in": "query",
				"description": "Worker service that emitted the Agent invocations.",
				"required": true,
				"schema": {
					"description": "Worker service that emitted the Agent invocations.",
					"type": "string",
					"maxLength": 512,
					"minLength": 1
				}
			},
			{
				"name": "agent",
				"in": "query",
				"description": "Agent name reported by the invocations (gen_ai.agent.name).",
				"required": true,
				"schema": {
					"description": "Agent name reported by the invocations (gen_ai.agent.name).",
					"type": "string",
					"maxLength": 512,
					"minLength": 1
				}
			},
			{
				"name": "from",
				"in": "query",
				"description": "Start of the window, as Unix epoch milliseconds. Clamped to the 7-day retention period.",
				"required": true,
				"schema": {
					"description": "Start of the window, as Unix epoch milliseconds. Clamped to the 7-day retention period.",
					"type": "integer",
					"minimum": 0
				}
			},
			{
				"name": "to",
				"in": "query",
				"description": "End of the window, as Unix epoch milliseconds. Must be later than from.",
				"required": true,
				"schema": {
					"description": "End of the window, as Unix epoch milliseconds. Must be later than from.",
					"type": "integer",
					"minimum": 0
				}
			},
			{
				"name": "cursor",
				"in": "query",
				"description": "Opaque cursor returned in result_info.cursors.after.",
				"schema": {
					"description": "Opaque cursor returned in result_info.cursors.after.",
					"type": "string",
					"maxLength": 2048,
					"minLength": 1
				}
			},
			{
				"name": "per_page",
				"in": "query",
				"schema": {
					"type": "integer",
					"maximum": 100,
					"minimum": 1
				}
			}
		],
