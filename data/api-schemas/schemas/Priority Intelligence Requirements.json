					"minLength": 1
				}
			}
		],
		"requestBody": {
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"as_of": {
								"type": "string",
								"format": "date-time"
							},
							"backtest_days": {
								"type": "integer",
								"default": 30,
								"maximum": 90,
								"minimum": 1
							},
							"candidate_limit": {
								"type": "integer",
								"maximum": 100,
								"minimum": 1
							},
							"dataset_ids": {
								"type": "array",
								"items": {
									"minLength": 1,
									"type": "string"
								},
								"maxItems": 50,
								"minItems": 1
							},
							"emerging_min_current_count": {
								"type": "integer",
								"maximum": 100000,
								"minimum": 1
							},
							"established_min_absolute_delta": {
								"type": "integer",
								"maximum": 100000,
								"minimum": 1
							},
							"established_min_prior_count": {
								"type": "integer",
								"maximum": 100000,
								"minimum": 1
							},
							"established_min_relative_delta": {
								"type": "number",
								"maximum": 100,
								"minimum": 0,
								"nullable": true
							},
							"window_days": {
								"type": "integer",
								"default": 7,
