	"PUT /accounts/{account_id}/settings/transformations/workers/{script_name}": {
		"operationId": "account-settings-update-worker-transformations",
		"summary": "Set Image Transformations setting for a Worker",
		"description": "Sets the `/cdn-cgi/image/` URL transformations setting for requests served by a Worker.\nThis overrides the zone-level Image Transformations and Allowed Origins settings for\nrequests handled by the Worker.\n",
