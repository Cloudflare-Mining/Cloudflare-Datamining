{
	"POST /accounts/{account_id}/workers/workers/{worker_id}/versions/{version_id}/profile": {
		"operationId": "profileWorkerVersion",
		"summary": "Profile Worker Version",
		"description": "Captures a CPU or heap profile from a recently active isolate running the specified Worker version. This endpoint requires the Worker profiling feature to be enabled for the account.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Identifier.",
					"type": "string",
					"example": "023e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"x-auditable": true
				}
			},
			{
				"name": "worker_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Identifies the Worker by ID or name.",
					"type": "string"
				}
			},
			{
				"name": "version_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Identifies the version by UUID or UUID prefix with a minimum length of eight characters. Use \"latest\" to select the most recently created version.",
					"type": "string"
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"actor_id": {
								"description": "Identifies the exact Durable Object actor to profile. Must be specified together with namespace_id. The actor must currently be active and running the requested Worker version.",
								"type": "string",
								"pattern": "^[0-9a-fA-F]{64}$"
							},
							"duration_ms": {
								"description": "Profile duration in milliseconds.",
								"type": "integer",
								"format": "int32",
								"maximum": 50000,
								"minimum": 1000
							},
							"namespace_id": {
								"description": "Identifies the Durable Object namespace containing the actor to profile. Must be specified together with actor_id.",
								"type": "string"
							},
							"profile_type": {
								"type": "string",
								"default": "cpu",
								"enum": [
									"cpu",
									"heap"
								]
							}
						},
						"required": [
							"duration_ms"
						]
					}
				}
			}
		},
		"responses": {
			"200": {
				"description": "Compressed pprof profile data.",
				"headers": {
					"Content-Disposition": {
						"schema": {
							"type": "string"
						}
					},
					"Content-Encoding": {
						"schema": {
							"type": "string",
							"enum": [
								"gzip"
							]
						}
					}
				},
				"content": {
