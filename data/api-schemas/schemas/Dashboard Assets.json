				"description": "RFI project type. Valid values: threat-intelligence, incident-response, ir-emergency-response, table-top, pentest, irp, threat-hunting, cybersecurity-assessment, react-general, legal-response, soc-alerts, demo",
				"required": true,
				"schema": {
					"description": "RFI project type. Valid values: threat-intelligence, incident-response, ir-emergency-response, table-top, pentest, irp, threat-hunting, cybersecurity-assessment, react-general, legal-response, soc-alerts, demo",
					"type": "string",
					"example": "threat-intelligence",
					"enum": [
						"threat-intelligence",
						"incident-response",
						"ir-emergency-response",
						"table-top",
						"pentest",
						"irp",
						"threat-hunting",
						"cybersecurity-assessment",
						"react-general",
						"legal-response",
						"soc-alerts",
						"demo"
					]
				}
			},
			{
				"name": "request_id",
				"in": "path",
				"description": "RFI UUID",
				"required": true,
				"schema": {
					"description": "RFI UUID",
					"type": "string"
				}
			},
			{
				"name": "asset_id",
				"in": "path",
				"description": "Asset UUID",
				"required": true,
				"schema": {
					"description": "Asset UUID",
					"type": "string"
				}
			}
		],
		"responses": {
			"200": {
				"description": "Asset file content",
				"content": {
					"application/octet-stream": {
						"schema": {
							"type": "string",
							"format": "binary"
						}
					}
				}
			},
			"404": {
				"description": "Asset not found or not downloadable: deleted, revoked, never shared, its origin is outside the dashboard visibility policy, or (for an attachment) its parent message is unpublished or deleted."
			},
			"410": {
				"description": "The asset's share window has expired."
			}
		},
		"security": [
			{
				"api_token": []
			}
		],
		"tags": [
			"Dashboard Assets"
