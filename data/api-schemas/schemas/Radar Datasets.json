					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"properties": {
											"message": {
												"type": "string"
											}
										},
										"required": [
											"message"
										],
										"type": "object"
									}
								},
								"result": {
									"type": "object"
								},
								"success": {
									"type": "boolean",
									"example": false
								}
							},
							"required": [
