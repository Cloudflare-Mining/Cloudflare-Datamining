													},
													"tags": {
														"type": "array",
														"items": {
															"example": "global",
															"type": "string"
														}
													},
													"title": {
														"type": "string",
														"example": "Top bucket 20000 domains"
													},
													"type": {
														"type": "string",
														"example": "RANKING_BUCKET"
													}
												},
												"required": [
													"id",
													"title",
													"description",
													"type",
													"tags",
													"meta"
												],
												"type": "object"
											}
										}
									},
									"required": [
										"datasets"
									]
								},
								"success": {
									"type": "boolean",
									"example": true
								}
