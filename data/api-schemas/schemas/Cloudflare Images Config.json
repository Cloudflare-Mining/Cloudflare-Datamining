	"PATCH /accounts/{account_id}/images/v1/config": {
		"operationId": "cloudflare-images-config-edit",
		"summary": "Update Images account configuration",
		"description": "Update account-level Cloudflare Images settings. Only the settings included in the request are changed.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Account identifier tag.",
					"type": "string",
					"example": "023e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"readOnly": true,
					"x-auditable": true
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"example": {
						"preserve_content_credentials": true
					},
					"schema": {
						"description": "Settings to change. Settings omitted from the request are left unchanged.",
						"type": "object",
						"properties": {
							"flexible_variants": {
								"description": "Whether flexible variants are enabled. When `true`, hosted images can be transformed with options in the URL (for example `https://imagedelivery.net/<ACCOUNT_HASH>/<IMAGE_ID>/w=400,sharpen=3`) instead of only through named variants. When `false` or absent, only named variants can be requested.\n",
								"type": "boolean",
