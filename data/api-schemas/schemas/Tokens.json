						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"properties": {
											"code": {
												"type": "number"
											},
											"message": {
												"type": "string"
											},
											"path": {
												"type": "array",
												"items": {
													"type": "string"
												}
											}
										},
										"required": [
