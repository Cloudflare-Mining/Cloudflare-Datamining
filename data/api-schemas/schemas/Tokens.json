{
	"POST /accounts/{account_id}/networkquality/token": {
		"operationId": "network-quality-create-authorization-token",
		"summary": "Create a Network Quality Test authorization token",
		"description": "Issues an authorization token for a Network Quality Test client.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Cloudflare account identifier.",
				"required": true,
				"schema": {
					"description": "Cloudflare account identifier.",
					"type": "string",
					"example": "0123456789abcdef0123456789abcdef",
					"pattern": "^[0-9a-f]{32}$"
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"bytes": {
								"description": "Customer-defined byte budget signed into the token for downstream enforcement and billing",
								"type": "integer",
								"example": 1000000000,
								"exclusiveMinimum": true,
								"maximum": 34359738368,
								"minimum": 0
							},
							"eyeball_id": {
								"type": "string",
								"example": "eyeball-7f3a",
								"pattern": "^[A-Za-z0-9_.:-]{8,128}$"
							},
							"source_ips": {
								"type": "array",
								"items": {
									"anyOf": [
										{
											"format": "ipv4",
											"type": "string"
										},
										{
											"format": "ipv6",
											"type": "string"
										},
										{
											"format": "ipv4-cidr",
											"type": "string"
										},
										{
											"format": "ipv6-cidr",
											"type": "string"
										}
									],
									"description": "An IPv4 or IPv6 address or CIDR, excluding unspecified addresses and catch-all CIDRs."
								},
								"example": [
									"203.0.113.42",
									"2001:db8::/32"
								],
								"default": [],
								"maxItems": 8
							}
						},
						"additionalProperties": false,
						"required": [
							"bytes",
							"eyeball_id"
						]
					}
				}
			}
		},
		"responses": {
			"200": {
				"description": "Authorization token",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"errors": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"example": [],
									"maxItems": 0
								},
								"messages": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"example": [],
									"maxItems": 0
								},
								"result": {
									"type": "object",
									"properties": {
										"token": {
											"type": "string",
											"example": "eyJhbGciOiJFUzI1NiIsInR5cCI6ImNmc3BlZWQrand0Iiwia2lkIjoiMDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwIn0..AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
											"x-forge-sensitive": true,
											"x-sensitive": true
										}
									},
									"required": [
										"token"
									]
								},
								"success": {
									"type": "boolean",
									"enum": [
										true
									]
								}
							},
							"required": [
								"success",
								"errors",
								"messages",
								"result"
							]
						}
					}
				}
			},
			"400": {
				"description": "Invalid request body",
