	"GET /accounts/{account_id}/k2/streams/{stream_id}/subscriptions": {
		"operationId": "getV4AccountsByAccount_idK2StreamsByStream_idSubscriptions",
		"summary": "List K2 stream subscriptions",
		"description": "Lists every subscription on one stream, oldest first. Lag uses committed positions, not reserved read positions. A failed tail observation preserves subscription metadata and returns unavailable lag.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Specifies the public ID of the account.",
					"type": "string",
					"example": "0123105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"minLength": 32,
					"pattern": "^[a-f0-9]{32}$"
				}
			},
			{
				"name": "stream_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Specifies the public ID of the K2 stream.",
					"type": "string",
					"example": "053e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"minLength": 32,
					"pattern": "^[a-f0-9]{32}$"
				}
			}
		],
		"responses": {
			"200": {
				"description": "Every subscription on the K2 stream, with observed committed-position lag.",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"result": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"created_at": {
												"type": "string",
												"format": "date-time"
											},
											"id": {
												"type": "string",
												"pattern": "^[a-f0-9]{32}$"
											},
											"lag": {
												"type": "object",
												"properties": {
													"records": {
														"description": "Decimal-string distance from the subscription's committed position to the observed exclusive stream tail, in records. Includes in-flight records and may include expired records or records acknowledged beyond an earlier gap. Null unless status is available.",
														"type": "string",
														"nullable": true,
														"pattern": "^(0|[1-9][0-9]*)$"
													},
													"status": {
														"description": "Unsupported means the subscription or stream topology cannot be measured; unavailable means a required observation failed or was inconsistent.",
														"type": "string",
														"enum": [
															"available",
															"unsupported",
															"unavailable"
														]
													}
												},
												"required": [
													"status",
													"records"
												]
											},
											"modified_at": {
												"type": "string",
												"format": "date-time"
											},
											"name": {
												"type": "string"
											},
											"start_at": {
												"type": "object",
												"properties": {
													"type": {
														"type": "string",
														"enum": [
															"earliest",
															"latest"
														]
													}
												},
												"required": [
													"type"
												]
											}
										},
										"required": [
											"id",
											"name",
											"start_at",
											"created_at",
											"modified_at",
											"lag"
										]
									}
								},
