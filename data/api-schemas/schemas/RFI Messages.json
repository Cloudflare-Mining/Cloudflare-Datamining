	"POST /accounts/{account_id}/cloudforce-one/v2/requests/{project_type}/{request_id}/messages/new": {
		"operationId": "post_MessageCreate",
		"summary": "Create a customer follow-on message on an RFI request",
		"description": "Creates a customer dashboard message on an RFI request. Messages are always published on send. Workflow-enabled projects require Idempotency-Key and atomically record message activity and any policy transition. For token-billed project types, substantive follow-on messages consume message tokens and are subject to quarterly quota enforcement.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				}
			},
			{
				"name": "project_type",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				}
			},
			{
				"name": "request_id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				}
			},
			{
				"name": "Idempotency-Key",
				"in": "header",
				"description": "Client command key. Required when publishing a message for a workflow-enabled project; trimmed and limited to 255 characters.",
				"schema": {
					"description": "Client command key. Required when publishing a message for a workflow-enabled project; trimmed and limited to 255 characters.",
					"type": "string"
				}
			}
		],
		"requestBody": {
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"attachment_asset_ids": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"author_id": {
								"type": "string"
							},
							"author_name": {
								"type": "string"
							},
							"content": {
								"minLength": 1,
								"type": "string"
							},
							"publish": {
								"type": "boolean",
								"default": false
							},
							"tlp": {
								"type": "string",
								"default": "red",
								"enum": [
									"clear",
									"green",
									"amber",
									"amber-strict",
									"red",
									"white"
								]
							}
						},
						"required": [
							"content"
						]
					}
				}
			}
		},
		"responses": {
			"200": {
				"description": "Message created and published. Returns the created message with its embedded attachments[], filtered to the dashboard's visible origins.",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"attachments": {
									"type": "array",
