										"properties": {
											"contentType": {
												"type": "string"
											},
											"downloadable": {
												"type": "boolean"
											},
											"fileName": {
												"type": "string"
											},
											"fileSize": {
												"type": "integer"
											},
											"id": {
												"type": "string"
											},
											"is_cloudflare_team": {
												"type": "boolean"
											},
											"origin": {
												"type": "string",
												"enum": [
													"cloudflare",
													"self"
												]
											},
											"state": {
												"type": "string",
												"enum": [
													"active",
													"expired",
													"revoked"
												]
											}
