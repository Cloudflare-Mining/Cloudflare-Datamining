													"message"
												],
												"type": "object",
												"uniqueItems": true
											},
											"example": []
										}
									],
									"minItems": 1
								},
								"messages": {
									"example": [],
									"allOf": [
										{
											"type": "array",
											"items": {
												"properties": {
													"code": {
														"type": "integer",
														"minimum": 1000
													},
													"message": {
														"type": "string"
													}
												},
												"required": [
													"code",
													"message"
												],
												"type": "object",
												"uniqueItems": true
											},
											"example": []
										}
									]
								},
								"result": {
									"type": "object",
									"enum": [
										null
									],
									"nullable": true
								},
								"success": {
									"description": "Whether the API call was successful.",
									"type": "boolean",
									"example": false,
									"enum": [
										false
									]
								}
							},
							"required": [
								"success",
								"errors",
								"messages",
								"result"
							]
						}
					}
				}
			}
		},
		"security": [
			{}
		],
		"tags": [
			"API Versioning"
		]
	},
