	"PATCH /accounts/{account_id}/ai-gateway/logging-state": {
		"operationId": "aig-config-patch-logging-state",
		"summary": "Migrate AI Gateway logging to Workers Observability",
		"description": "Irreversibly migrates an eligible account to Workers Observability logging.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				}
			}
		],
		"responses": {
			"200": {
				"description": "Returns the migrated account logging state",
				"content": {
					"application/json": {
						"schema": {
