			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Identifier.",
					"type": "string",
					"example": "023e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"readOnly": true,
					"x-auditable": true
				}
			}
		],
