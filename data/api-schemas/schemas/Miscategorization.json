								]
							},
							"url": {
								"description": "Provide only if indicator_type is `domain` or `url`. Example if indicator_type is `domain`: `example.com`. Example if indicator_type is `url`: `https://example.com/news/`.",
								"type": "string",
								"x-auditable": true
							}
						}
					}
				}
			}
