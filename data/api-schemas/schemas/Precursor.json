	"PUT /zones/{zone_id}/precursor": {
		"operationId": "precursor-for-a-zone-update-config",
		"summary": "Update Zone Precursor Config",
		"description": "Updates the Precursor configuration for a zone.\n\n`mode` controls whether Precursor detection is off, monitoring, or\narmed. `show_interstitial` controls the zone-level response when armed.\n`rules` is the ordered list of overrides for matching requests.\n\nThis is a partial update: only the fields present in the request body\nare changed.\n\n- Sending an empty array (`[]`) clears all rules.\n- At least one of `mode`, `show_interstitial`, or `rules` must be\n  present; an empty body (`{}`) is rejected with `400`.\n- Rule `id` is read-only (assigned by Cloudflare) and ignored on input.\n- Rule `show_interstitial` is required and controls the response for\n  requests that match that rule.\n- Rule `expression` is limited to 4000 characters. The limit applies to\n  each rule individually, not to the combined size of all rules.\n",
		"parameters": [
			{
				"name": "zone_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Identifier.",
					"type": "string",
					"example": "023e105f4ecef8ad9ca31a8372d0c353",
					"maxLength": 32,
					"x-auditable": true
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"examples": {
						"monitor": {
							"summary": "Monitor detections without affecting bot scores",
							"value": {
								"mode": "monitor"
							}
						},
						"off": {
							"summary": "Disable precursor for the zone",
							"value": {
								"mode": "off"
							}
						},
						"rules-only": {
							"summary": "Replace rules while leaving zone-level settings unchanged",
							"value": {
								"rules": [
									{
										"description": "Show an interstitial on the login path",
										"enabled": true,
										"expression": "http.request.uri.path eq \"/login\"",
										"show_interstitial": true
									}
								]
							}
						},
						"with-rules": {
							"summary": "Arm detection and configure an interstitial override",
							"value": {
								"mode": "arm",
								"rules": [
									{
										"description": "Show an interstitial on the login path",
										"enabled": true,
										"expression": "http.request.uri.path eq \"/login\"",
										"show_interstitial": true
									}
								],
								"show_interstitial": false
							}
						}
					},
					"schema": {
						"type": "object",
						"properties": {
							"mode": {
								"description": "Controls Precursor detection for the zone. `off` disables detection,\n`monitor` records detections without affecting bot scores, and `arm`\nallows detections to affect bot scores.\n",
								"type": "string",
								"example": "off",
								"default": "off",
								"enum": [
									"off",
									"monitor",
									"arm"
								],
								"x-auditable": true
							},
							"rules": {
								"description": "The ordered list of Precursor rules for the zone.",
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"description": {
											"description": "An informative description of the rule.",
											"type": "string",
											"example": "Show an interstitial on the login path",
											"default": "",
											"x-auditable": true
										},
										"enabled": {
											"description": "Whether the rule is active.",
											"type": "boolean",
											"example": true,
											"default": true,
											"x-auditable": true
										},
										"expression": {
											"description": "The filter expression that determines which requests the rule matches.",
											"type": "string",
											"example": "http.request.uri.path eq \"/login\"",
											"maxLength": 4000,
											"x-auditable": true
										},
										"id": {
											"description": "The read-only identifier that Cloudflare assigns to the rule.",
											"type": "string",
											"example": "3a03d665bac043e3a684e0d385a4b1e2",
											"readOnly": true,
											"x-auditable": true
										},
										"show_interstitial": {
											"description": "Whether Precursor shows an interstitial when it takes action on a\nrequest.\n",
											"type": "boolean",
											"example": true,
											"x-auditable": true
										}
									},
									"required": [
										"expression",
										"show_interstitial"
									],
									"title": "Precursor Rule"
								}
							},
							"show_interstitial": {
								"description": "Whether Precursor shows an interstitial when it takes action on a\nrequest.\n",
								"type": "boolean",
								"example": true,
								"x-auditable": true
							}
						},
						"example": {
							"mode": "arm",
							"rules": [
								{
									"description": "Show an interstitial on the shop page",
									"enabled": true,
									"expression": "http.request.uri.path eq \"/shop\"",
									"show_interstitial": true
								}
							],
							"show_interstitial": false
						},
						"minProperties": 1,
						"title": "Precursor Config"
					}
				}
			}
		},
