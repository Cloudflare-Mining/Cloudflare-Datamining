{
	"GET /accounts/{account_id}/builds/repos/{provider_type}/{provider_account_id}/{repo_id}/config_autofill": {
		"operationId": "getWorkerConfigAutofill",
		"summary": "Get repository configuration autofill",
		"description": "Analyze repository for automatic configuration detection",
		"parameters": [
			{
				"in": "path",
				"name": "account_id",
				"required": true,
				"schema": {
					"description": "Account identifier.",
					"type": "string",
					"example": "account-123"
				}
			},
			{
				"name": "provider_type",
				"in": "path",
				"description": "SCM provider type",
				"required": true,
				"schema": {
					"type": "string",
					"example": "github",
					"enum": [
						"github",
						"gitlab",
						"gitlab_internal"
					]
				}
			},
			{
				"name": "provider_account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Provider account identifier.",
					"type": "string",
					"example": "cloudflare"
				}
			},
			{
				"name": "repo_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Repository identifier.",
					"type": "string",
					"example": "workers-sdk"
				}
			},
			{
				"name": "branch",
				"in": "query",
				"required": true,
				"schema": {
					"description": "Git branch name.",
					"type": "string",
					"example": "main"
				}
			},
			{
				"name": "root_directory",
				"in": "query",
				"schema": {
					"description": "Root directory path.",
					"type": "string",
					"example": "/"
				}
			}
		],
		"responses": {
			"200": {
				"description": "Configuration autofill data retrieved successfully",
				"content": {
					"application/json": {
						"schema": {
							"allOf": [
								{
									"type": "object",
									"properties": {
										"errors": {
											"type": "array",
											"items": {
												"properties": {
													"code": {
														"type": "integer",
														"example": 12000
													},
													"message": {
														"type": "string",
														"example": "Not found"
													}
												},
												"type": "object"
											}
										},
										"messages": {
											"type": "array",
											"items": {
												"type": "string"
											}
										},
										"result": {
											"type": "object",
											"nullable": true
										},
										"result_info": {
											"type": "object",
											"properties": {
												"count": {
													"type": "integer",
													"example": 25
												},
												"page": {
													"type": "integer",
													"example": 1
												},
												"per_page": {
													"type": "integer",
													"example": 50
												},
												"total_count": {
													"type": "integer",
													"example": 150
												},
												"total_pages": {
													"type": "integer",
													"example": 3
												}
											}
										},
										"success": {
											"type": "boolean",
											"example": true
										}
									},
									"required": [
										"success",
										"errors",
										"messages",
										"result"
									]
								},
								{
									"properties": {
										"result": {
											"type": "object",
											"properties": {
												"config_file": {
													"type": "string",
													"example": "wrangler.toml",
													"nullable": true
												},
												"default_worker_name": {
													"type": "string",
													"example": "my-worker",
													"nullable": true
												},
												"env_worker_names": {
													"type": "object",
													"example": {
														"production": "my-worker-prod",
														"staging": "my-worker-staging"
													},
													"additionalProperties": {
														"type": "string"
													},
													"nullable": true
												},
												"package_manager": {
													"type": "string",
													"allOf": [
														{
															"type": "string",
															"example": "npm",
															"enum": [
																"npm",
																"yarn",
																"pnpm",
																"bun",
																"uv"
															]
														}
													],
													"nullable": true
												},
												"scripts": {
													"type": "object",
													"example": {
														"build": "npm run build",
														"test": "npm test"
													},
													"additionalProperties": {
														"type": "string"
													},
													"nullable": true
												}
											}
										}
									},
									"type": "object"
								}
							]
						}
					}
				}
			}
		},
		"security": [
			{
				"api_token": []
			},
			{
				"api_email": [],
				"api_key": []
			}
		],
		"tags": [
			"GitHub Integration"
		],
		"x-api-token-group": [
			"Workers CI Write",
			"Workers CI Read"
		],
		"x-fern-availability": "generally-available",
		"x-fern-sdk-group-name": "workers-builds.repos.config-autofill",
		"x-fern-sdk-method-name": "get",
		"x-forge-hidden": true
	}
}