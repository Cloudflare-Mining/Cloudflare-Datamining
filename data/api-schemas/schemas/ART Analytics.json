												"type": "integer",
												"example": 11005
											},
											"message": {
												"type": "string",
												"example": "art.api.parameter.invalid"
											}
										}
									}
								},
								"messages": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
