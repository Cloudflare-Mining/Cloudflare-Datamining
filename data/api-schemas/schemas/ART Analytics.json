												"type": "integer",
												"example": 1000
											},
											"message": {
												"type": "string",
												"example": "API in beta: expect breaking changes."
											}
										}
									}
								},
								"result": {
									"type": "object",
									"nullable": true
								},
								"success": {
									"type": "boolean",
									"example": false
								}
							},
							"required": [
