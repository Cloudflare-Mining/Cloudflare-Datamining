{
	"GET /feedback/diagnosis": {
		"operationId": "feedback-diagnosis",
		"summary": "Get the project feedback prompt",
		"description": "Returns the Cloudflare team's whole-project feedback prompt. An agent follows `instructions` to review how the user's project uses Cloudflare and write a report on what got in the way, shows the user the full report, and sends it with `POST /feedback/send` once the user approves.",
		"responses": {
			"200": {
				"description": "The project feedback prompt.",
				"content": {
					"application/json": {
						"schema": {
							"allOf": [
								{
									"type": "object",
									"properties": {
										"errors": {
											"type": "array",
											"items": {
												"properties": {
													"code": {
														"description": "The error or message code.",
														"type": "integer",
														"minimum": 1000
													},
													"documentation_url": {
														"description": "A link to documentation about the error.",
														"type": "string"
													},
													"message": {
														"description": "A short description.",
														"type": "string"
													}
												},
												"required": [
													"code",
													"message"
												],
												"type": "object"
											}
										},
										"messages": {
											"type": "array",
											"items": {
												"properties": {
													"code": {
														"description": "The error or message code.",
														"type": "integer",
														"minimum": 1000
													},
													"documentation_url": {
														"description": "A link to documentation about the error.",
														"type": "string"
													},
													"message": {
														"description": "A short description.",
														"type": "string"
													}
												},
												"required": [
													"code",
													"message"
												],
												"type": "object"
											}
										},
										"success": {
											"description": "Whether the API call was successful.",
											"type": "boolean",
											"enum": [
												true
											]
										}
									},
									"required": [
										"success",
										"errors",
										"messages"
									]
								},
								{
									"properties": {
										"result": {
											"type": "object",
											"properties": {
												"instructions": {
													"description": "The prompt for the agent, in Markdown.",
													"type": "string"
												},
												"prompt_version": {
													"description": "Version of the prompt in `instructions`.",
													"type": "string",
													"example": "2026-11-24T00:00:00Z"
												},
												"schema_version": {
													"description": "Version of this response format.",
													"type": "integer",
													"enum": [
														1
													]
												},
												"submit": {
													"description": "How to send the finished report.",
													"type": "object",
													"properties": {
														"method": {
															"description": "The HTTP method for sending the report.",
															"type": "string",
															"example": "POST"
														},
														"notes": {
															"description": "Rules for sending, such as asking the user first.",
															"type": "string"
														},
														"path": {
															"description": "The path to send the report to.",
															"type": "string",
															"example": "/client/v4/feedback/send"
														},
														"schema_version": {
															"description": "The `schema_version` to send with the report.",
															"type": "integer",
															"example": 1
														},
														"type": {
															"description": "The feedback `type` to send with the report.",
															"type": "string",
															"example": "friction"
														}
													},
													"required": [
														"method",
														"path",
														"schema_version",
														"type",
														"notes"
													]
												}
											},
											"required": [
												"schema_version",
												"prompt_version",
												"instructions",
												"submit"
											]
										}
									},
									"type": "object"
								}
							]
						}
					}
				}
			},
