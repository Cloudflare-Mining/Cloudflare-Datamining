	"POST /feedback/send": {
		"operationId": "feedback-send",
		"summary": "Send feedback",
		"description": "Report a problem with Cloudflare products, the cf CLI, or the Cloudflare MCP server and its tools to the Cloudflare team. While you work, keep track of what went wrong: failed calls, errors, wrong or confusing results, missing commands or tools. Send feedback near the end of the task if it hit a Cloudflare problem: several failed attempts, an error that looks like a Cloudflare bug, or a workaround you had to find. Also send feedback at the user's request. Skip it if the task went fine or the problem was in the user's own code. Send at most once per task; never send to test the endpoint or to log progress. Describe what was attempted, what was expected and what happened. Leave out secrets, API tokens, personal data, account or zone IDs and full conversations. After a successful submission, if you are an agent, tell the user at the next natural break, such as the end of the current turn, that you sent feedback to Cloudflare. Include the `submission_id`.",
		"parameters": [
			{
				"name": "User-Agent",
				"in": "header",
				"description": "Identifies the client. Must start with `cf-cli/<version>` or `cloudflare-mcp`.",
				"required": true,
				"schema": {
					"type": "string",
					"example": "cf-cli/1.4.0"
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"example": {
						"message": "The deploy output does not say which account it used.",
						"product": "workers",
						"schema_version": 1,
						"submission_id": "6f1c2b8e-3d4a-4f5b-9c6d-7e8f9a0b1c2d",
						"type": "friction"
					},
					"schema": {
						"type": "object",
						"properties": {
							"actual": {
								"description": "What happened instead.",
								"type": "string"
							},
							"agent": {
								"description": "A report from a coding agent, sent with `cf feedback --input-json` or the MCP server.",
								"type": "object",
								"properties": {
									"commands": {
										"description": "Commands the agent ran.",
										"type": "array",
										"items": {
											"properties": {
												"command": {
													"description": "The command path.",
													"type": "string"
												},
												"duration_ms": {
													"description": "How long it ran, in milliseconds.",
													"type": "integer",
													"minimum": 0
												},
												"exit_code": {
													"description": "The exit code.",
													"type": "integer"
												},
												"flags": {
													"description": "The flag names used.",
													"type": "array",
													"items": {
														"type": "string"
													},
													"maxItems": 50
												}
											},
											"required": [
												"command"
											],
											"type": "object"
										},
										"maxItems": 50
									},
									"docs_urls": {
										"description": "Documentation the agent read.",
										"type": "array",
										"items": {
											"maxLength": 2048,
											"type": "string"
										},
										"maxItems": 10
									},
									"errors": {
										"description": "Errors the agent hit.",
										"type": "array",
										"items": {
											"properties": {
												"code": {
													"description": "The error code, such as a Cloudflare API error code.",
													"type": "string",
													"maxLength": 64
												},
												"command": {
													"description": "The command that failed.",
													"type": "string"
												},
												"message": {
													"description": "The error message.",
													"type": "string"
												}
											},
											"required": [
												"message"
											],
											"type": "object"
										},
										"maxItems": 20
									},
									"model": {
										"description": "The model the agent used.",
										"type": "string"
									},
									"name": {
										"description": "The agent's name, such as `claude-code`.",
										"type": "string",
										"maxLength": 40
									},
									"repro_steps": {
										"description": "Steps to reproduce the problem.",
										"type": "array",
										"items": {
											"type": "string"
										},
										"maxItems": 30
									},
									"stats": {
										"description": "Counts for the task.",
										"type": "object",
										"properties": {
											"duration_ms": {
												"description": "How long the task took, in milliseconds.",
												"type": "integer",
												"minimum": 0
											},
											"retries": {
												"description": "Retries made.",
												"type": "integer",
												"minimum": 0
											},
											"tool_calls": {
												"description": "Tool calls made.",
												"type": "integer",
												"minimum": 0
											},
											"turns": {
												"description": "Conversation turns.",
												"type": "integer",
												"minimum": 0
											}
										}
									},
									"version": {
										"description": "The agent's version.",
										"type": "string",
										"maxLength": 64
									}
								}
							},
							"attempted": {
								"description": "What was tried.",
								"type": "string"
							},
							"client": {
								"description": "Context the cf CLI attaches: its version and mode, the platform, the detected agent and the last command.",
								"type": "object",
								"properties": {
									"agent_detected": {
										"description": "The coding agent the CLI detected, such as `claude-code`.",
										"type": "string",
										"maxLength": 40
									},
									"agent_model_detected": {
