											"requests": 220
										}
									]
								},
								"requests_by_score": {
									"1": 120,
									"2": 150,
									"3": 130,
									"4": 100
								},
								"requests_by_score_src": {
									"heuristics": 50,
									"ml": 450
								},
								"subtype": "Login Abuse",
								"type": "false_positive"
