										"type": "boolean"
									},
									"cli_mode": {
										"description": "How the CLI was run.",
										"type": "string",
										"enum": [
											"ci",
											"interactive",
											"non-interactive"
										]
									},
									"cli_version": {
										"description": "The cf CLI version.",
										"type": "string"
									},
									"error": {
										"description": "The error the CLI reported, if any.",
										"type": "object",
										"properties": {
											"message": {
												"description": "The error message.",
												"type": "string"
											},
											"stack": {
												"description": "The stack trace.",
												"type": "string"
											},
											"telemetry_message": {
												"description": "The error message as recorded by telemetry.",
												"type": "string"
											}
										}
									},
									"is_ci": {
										"description": "Whether the CLI ran in CI.",
										"type": "boolean"
									},
									"is_interactive": {
										"description": "Whether the CLI ran in an interactive terminal.",
										"type": "boolean"
									},
									"last_command": {
										"description": "The last cf command run before the feedback.",
										"type": "object",
										"properties": {
											"args_used": {
												"description": "The flag names used, without values.",
												"type": "array",
												"items": {
													"type": "string"
												},
												"maxItems": 50
											},
											"command": {
												"description": "The command path, such as `workers deploy`.",
												"type": "string"
											},
											"error_codes": {
												"description": "Cloudflare API error codes returned.",
												"type": "array",
												"items": {
													"type": "integer"
												},
												"maxItems": 20
