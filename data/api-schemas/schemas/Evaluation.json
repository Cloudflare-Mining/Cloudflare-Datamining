											"type": "array"
										}
									]
								}
							},
							"flagKey": {
								"description": "Key of the flag to evaluate within the app.",
								"type": "string",
								"maxLength": 64,
								"minLength": 1,
								"pattern": "^[a-zA-Z0-9_-]+$"
							}
						},
						"additionalProperties": false,
						"required": [
