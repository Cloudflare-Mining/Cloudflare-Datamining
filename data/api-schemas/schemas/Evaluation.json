	"POST /accounts/{account_id}/flagship/apps/{app_id}/evaluate": {
		"operationId": "flagship_evaluate_flag_post",
		"summary": "Evaluate flag with JSON context",
		"description": "Evaluates a flag against the provided context, passed as a JSON request body (OFREP-shaped) rather than query parameters. Returns the same response shape as the GET variant.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Cloudflare account ID that owns the Flagship app.",
				"required": true,
				"schema": {
					"description": "Cloudflare account ID that owns the Flagship app.",
					"type": "string"
				}
			},
			{
				"name": "app_id",
				"in": "path",
				"description": "Flagship app ID returned when the app was created.",
				"required": true,
				"schema": {
					"description": "Flagship app ID returned when the app was created.",
					"type": "string"
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"context": {
								"description": "Evaluation attributes keyed by name. Values may be any JSON value; the context supports up to 100 entries and 32 KB.",
								"type": "object",
								"default": {},
								"additionalProperties": {
									"oneOf": [
										{
											"nullable": true,
											"type": "string"
										},
										{
											"type": "number"
										},
										{
											"type": "boolean"
										},
										{
											"additionalProperties": "[Circular ~.POST /accounts/{account_id}/flagship/apps/{app_id}/evaluate.requestBody.content.application/json.schema.properties.context.additionalProperties]",
											"type": "object"
										},
										{
											"items": "[Circular ~.POST /accounts/{account_id}/flagship/apps/{app_id}/evaluate.requestBody.content.application/json.schema.properties.context.additionalProperties]",
											"type": "array"
										}
									]
								}
							},
							"flagKey": {
								"description": "Key of the flag to evaluate within the app.",
								"type": "string",
								"maxLength": 64,
								"minLength": 1,
								"pattern": "^[a-zA-Z0-9_-]+$"
							}
						},
						"additionalProperties": false,
						"required": [
							"flagKey"
						]
					}
				}
			}
		},
		"responses": {
			"200": {
				"description": "Flag evaluation result.",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
