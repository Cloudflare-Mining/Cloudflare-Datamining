	"DELETE /accounts/{account_id}/cloudforce-one/events/datasets/preferences": {
		"operationId": "delete_DatasetPreferencesDelete",
		"summary": "Remove default datasets",
		"description": "Removes your default datasets (`scope` `user`) or the account's (`scope` `account`). After you remove your own, requests that omit `datasetId` use the account's default datasets, if set.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Account ID.",
				"required": true,
				"schema": {
					"description": "Account ID.",
					"type": "string"
				}
			},
			{
				"name": "scope",
				"in": "query",
				"required": true,
				"schema": {
					"description": "`user` removes your own default datasets. `account` removes the account's, and requires permission to edit the account's Cloudforce One settings.",
