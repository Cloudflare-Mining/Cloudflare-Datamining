	"POST /accounts/{account_id}/pay-per-use/agreements": {
		"operationId": "pay-per-crawl.postPPUAgreement",
		"summary": "Propose a pay-per-use agreement",
		"description": "Submits the requesting buyer's offer to a publisher. A buyer has one open offer per publisher; a second returns 409. A missing or null price means no price is agreed yet. The account needs a pay-per-use operator configuration, but neither side needs to be enabled or Cloudflare verified.",
		"parameters": [
			{
				"description": "account id",
				"in": "path",
				"name": "account_id",
				"required": true,
				"schema": {
					"type": "string"
				},
				"x-auditable": true
			}
		],
		"requestBody": {
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"price_usd_microcents": {
								"description": "Offered price per use in USD microcents. Omit it or send null when no price is agreed yet.",
								"type": "integer",
								"format": "int64",
								"maximum": 999999900000,
								"minimum": 100000,
								"multipleOf": 100000,
								"nullable": true
							},
							"publisher_id": {
								"description": "Identifier of the publisher the offer is made to.",
								"type": "string",
								"pattern": "^[0-9a-f]{32}$"
							}
						},
						"required": [
							"publisher_id"
						]
					}
				}
			},
			"description": "Pay-per-use agreement",
			"required": true,
			"x-auditable": true
		},
