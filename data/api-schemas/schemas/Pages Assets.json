	"POST /pages/assets/upsert-hashes": {
		"operationId": "pages-assets-upsert-hashes",
		"summary": "Upsert asset hashes",
		"description": "Register the provided file hashes as recently uploaded to the Pages\nasset store. Used as part of the Pages Direct Upload workflow so future\ndeployments can avoid re-uploading files that are already present.\n\nAuthenticate with the JWT obtained from the upload-token endpoint:\nGET /accounts/{account_id}/pages/projects/{project_name}/upload-token\n",
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"example": {
						"hashes": [
							"a948904f2f0f479b8f936b8a0c5d9882",
							"b026324c6904b2a9cb4b88d6d61c81d1"
						]
