	"POST /accounts/{account_id}/ai-gateway/gateways/{gateway_id}/custom-domains": {
		"operationId": "aig-config-create-custom-domain",
		"summary": "Create a custom domain for a gateway",
		"description": "Provisions a Cloudflare-for-SaaS custom hostname and returns the CNAME target to point DNS at.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
