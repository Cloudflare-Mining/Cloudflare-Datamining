					"maxLength": 64,
					"minLength": 1,
					"pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$",
					"x-auditable": true
				}
			}
		],
		"requestBody": {
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"domain": {
								"description": "the customer-owned custom hostname",
								"type": "string",
								"example": "ai.acme.com",
								"maxLength": 253,
								"minLength": 1,
								"pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
