{
	"GET /accounts/{account_id}/cni/slots": {
		"operationId": "list_slots",
		"summary": "Retrieve a list of all slots matching the specified parameters",
		"description": "Lists all available infrastructure slots for the account, showing allocation status and\ncapacity.",
		"parameters": [
			{
				"name": "address_contains",
				"in": "query",
				"description": "If specified, only show slots with the given text in their address field",
				"schema": {
					"type": "string",
					"nullable": true
				}
			},
			{
				"name": "site",
				"in": "query",
				"description": "If specified, only show slots located at the given site",
				"schema": {
					"type": "string",
					"nullable": true
				}
			},
			{
				"name": "speed",
				"in": "query",
				"description": "If specified, only show slots that support the given speed",
				"schema": {
					"type": "string",
					"nullable": true
				}
			},
			{
				"name": "occupied",
				"in": "query",
				"description": "If specified, only show slots with a specific occupied/unoccupied state",
				"schema": {
					"type": "boolean",
					"nullable": true
				}
			},
			{
				"name": "cursor",
				"in": "query",
				"schema": {
					"type": "integer",
					"format": "int32",
					"nullable": true
				}
			},
			{
				"name": "limit",
				"in": "query",
				"schema": {
					"type": "integer",
					"minimum": 0,
					"nullable": true
				}
			},
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Customer account tag",
					"type": "string"
				}
			}
		],
		"responses": {
			"200": {
				"description": "List of matching slots",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"items": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"account": {
												"description": "Customer account tag",
												"type": "string"
											},
											"ccr_device_name": {
												"type": "string",
												"nullable": true
											},
											"facility": {
												"type": "object",
												"properties": {
													"address": {
														"type": "array",
														"items": {
															"type": "string"
														}
													},
													"name": {
														"type": "string"
													}
												},
												"required": [
													"name",
													"address"
												]
											},
											"id": {
												"description": "Slot ID",
												"type": "string",
												"format": "uuid"
											},
											"occupied": {
												"description": "Whether the slot is occupied or not",
												"type": "boolean"
											},
											"site": {
												"type": "string"
											},
											"speed": {
												"type": "string"
											}
										},
										"required": [
											"id",
											"occupied",
											"site",
											"speed",
											"facility"
										]
									}
								},
								"next": {
									"type": "integer",
									"format": "int32",
									"nullable": true
								}
							},
							"required": [
								"items"
							]
						}
					}
				}
			},
			"400": {
				"description": "Bad request"
			},
			"500": {
				"description": "Internal server error"
			}
		},
		"security": [
			{
				"api_email": [],
				"api_key": [],
				"api_token": []
			}
		],
		"tags": [
			"Slots"
		],
		"x-api-token-group": [
			"Magic WAN Write",
			"Magic WAN Read",
			"Magic Transit Read",
			"Magic Transit Write"
		],
		"x-fern-availability": "generally-available",
		"x-fern-sdk-group-name": "network-interconnects.slots",
		"x-fern-sdk-method-name": "list",
		"x-forge-hidden": true
	},
	"GET /accounts/{account_id}/cni/slots/{slot}": {
		"operationId": "get_slot",
		"summary": "Get information about the specified slot",
		"description": "Gets information about a specific infrastructure slot allocation.",
		"parameters": [
			{
				"name": "slot",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"format": "uuid"
				}
			},
			{
				"name": "account_id",
				"in": "path",
				"required": true,
				"schema": {
					"description": "Customer account tag",
					"type": "string"
				}
			}
		],
		"responses": {
			"200": {
				"description": "Information about the specified slot",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"properties": {
								"account": {
									"description": "Customer account tag",
									"type": "string"
								},
								"ccr_device_name": {
									"type": "string",
									"nullable": true
								},
								"facility": {
									"type": "object",
									"properties": {
										"address": {
											"type": "array",
											"items": {
												"type": "string"
											}
										},
										"name": {
											"type": "string"
										}
									},
									"required": [
										"name",
										"address"
									]
								},
								"id": {
									"description": "Slot ID",
									"type": "string",
									"format": "uuid"
								},
								"occupied": {
									"description": "Whether the slot is occupied or not",
									"type": "boolean"
								},
								"site": {
									"type": "string"
								},
								"speed": {
									"type": "string"
								}
							},
							"required": [
								"id",
								"occupied",
								"site",
								"speed",
								"facility"
							]
						}
					}
				}
			},
			"400": {
				"description": "Bad request"
			},
			"404": {
				"description": "Slot not found"
			},
			"500": {
				"description": "Internal server error"
			}
		},
		"security": [
			{
				"api_email": [],
				"api_key": [],
				"api_token": []
			}
		],
		"tags": [
			"Slots"
		],
		"x-api-token-group": [
			"Magic WAN Write",
			"Magic WAN Read",
			"Magic Transit Read",
			"Magic Transit Write"
		],
		"x-fern-availability": "generally-available",
		"x-fern-sdk-group-name": "network-interconnects.slots",
		"x-fern-sdk-method-name": "get",
		"x-forge-hidden": true
	}
}