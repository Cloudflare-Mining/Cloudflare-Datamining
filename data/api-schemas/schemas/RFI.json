	"POST /accounts/{account_id}/cloudforce-one/v2/requests/{project_type}": {
		"operationId": "post_RequestCreate",
		"summary": "Creates a new RFI",
		"description": "Creates a new Request for Information with the specified project type and details.",
		"parameters": [
			{
				"name": "account_id",
				"in": "path",
				"description": "Account ID.",
				"required": true,
				"schema": {
