			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"description": {
								"description": "RFI description (optional). Defaults to an empty string when omitted.",
								"type": "string",
								"example": "We need analysis of domain patterns observed in recent security events"
							},
							"eventId": {
								"description": "Optional related event ID",
								"type": "string",
								"example": "event-456",
								"nullable": true
							},
							"metadata": {
								"description": "Optional metadata fields specific to the RFI type",
								"type": "object",
								"additionalProperties": true
							},
							"priority": {
								"description": "RFI priority. Four-level projects use `low`, `routine`, `high`, `urgent`; existing projects retain legacy `low`->routine compatibility. `medium`, `critical`, and `unknown` remain accepted legacy aliases. Defaults to `routine`.",
								"type": "string",
								"example": "routine",
								"enum": [
									"low",
									"routine",
									"high",
									"urgent",
									"unknown",
									"medium",
									"critical"
								]
							},
							"request_type": {
								"description": "Optional request type for the request",
								"type": "string",
								"nullable": true
							},
							"subtypeId": {
								"description": "Optional subtype ID",
								"type": "string",
								"example": "subtype-123",
								"nullable": true
							},
							"title": {
								"description": "RFI title (optional). When omitted, the server generates a summary from the request type and readable ID.",
								"type": "string",
								"example": "Investigation into suspicious domain activity"
							},
							"tlp": {
								"description": "Traffic Light Protocol level. Canonical values are `clear`, `green`, `amber`, `amber-strict`, `red`, `purple`. `white` and `amber+strict` are accepted input aliases; responses always use the canonical spelling.",
								"type": "string",
								"example": "amber",
								"enum": [
									"clear",
									"green",
									"amber",
									"amber-strict",
									"red",
									"purple",
									"white",
									"amber+strict"
								]
							}
						}
