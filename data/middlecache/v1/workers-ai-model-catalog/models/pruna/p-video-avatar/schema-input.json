{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"image": {
			"type": "string",
			"description": "Input portrait image (first frame). HTTP(S) URL or data URI. Supports jpg, jpeg, png, webp."
		},
		"audio": {
			"description": "URL of uploaded audio to drive speech. HTTP(S) URL or data URI. If both audio and voice_script are provided, audio takes priority.",
			"type": "string"
		},
		"voice": {
			"default": "Zephyr (Female)",
			"description": "Voice for generated speech.",
			"type": "string",
			"enum": [
				"Zephyr (Female)",
				"Puck (Male)",
				"Charon (Male)",
				"Kore (Female)",
				"Fenrir (Male)",
				"Leda (Female)",
				"Orus (Male)",
				"Aoede (Female)",
				"Callirrhoe (Female)",
				"Autonoe (Female)",
				"Enceladus (Male)",
				"Iapetus (Male)",
				"Umbriel (Male)",
				"Algenib (Male)",
				"Despina (Female)",
				"Erinome (Female)",
				"Laomedeia (Female)",
				"Achernar (Female)",
				"Algieba (Male)",
				"Schedar (Male)",
				"Gacrux (Female)",
				"Pulcherrima (Female)",
				"Achird (Male)",
				"Zubenelgenubi (Male)",
				"Vindemiatrix (Female)",
				"Sadachbia (Male)",
				"Sadaltager (Male)",
				"Sulafat (Female)",
				"Alnilam (Male)",
				"Rasalgethi (Male)"
			]
		},
		"voice_script": {
			"default": "",
			"description": "Script for the person to say when no audio is uploaded.",
			"type": "string"
		},
		"voice_language": {
			"default": "English (US)",
			"description": "Output language.",
			"type": "string",
			"enum": [
				"English (US)",
				"English (UK)",
				"Spanish",
				"French",
				"German",
				"Italian",
				"Portuguese (Brazil)",
				"Japanese",
				"Korean",
				"Hindi"
			]
		},
		"resolution": {
			"default": "720p",
			"description": "Resolution of the video.",
			"type": "string",
			"enum": [
				"720p",
				"1080p"
			]
		},
		"video_prompt": {
			"default": "The person is talking.",
			"description": "Optional prompt for the video.",
			"type": "string"
		},
		"voice_prompt": {
			"default": "Say the following.",
			"description": "Optional speaking style, tone, pacing or emotion instructions.",
			"type": "string"
		},
		"negative_prompt": {
			"default": "",
			"description": "Mention what you do NOT want in the video. Disabled if empty.",
			"type": "string"
		},
		"strength_negative_prompt": {
			"default": 0.5,
			"description": "Strength of the negative prompt (0-4).",
			"type": "number",
			"minimum": 0,
			"maximum": 4
		},
		"seed": {
			"description": "Random seed for reproducible generation.",
			"type": "integer",
			"minimum": -9007199254740991,
			"maximum": 9007199254740991
		},
		"disable_safety_filter": {
			"default": true,
			"description": "Disable safety filter for prompts and input image.",
			"type": "boolean"
		},
		"disable_prompt_upsampling": {
			"default": false,
			"description": "When true, skip the prompt upsampler and pass the raw user prompt.",
			"type": "boolean"
		}
	},
	"required": [
		"image",
		"voice",
		"voice_script",
		"voice_language",
		"resolution",
		"video_prompt",
		"voice_prompt",
		"negative_prompt",
		"strength_negative_prompt",
		"disable_safety_filter",
		"disable_prompt_upsampling"
	],
	"additionalProperties": {}
}
