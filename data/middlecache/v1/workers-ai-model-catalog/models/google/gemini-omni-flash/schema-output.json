{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"video": {
			"anyOf": [
				{
					"type": "string",
					"pattern": "^data:.*"
				},
				{
					"type": "string",
					"format": "uri"
				}
			]
		}
	},
	"required": [
		"video"
	],
	"additionalProperties": false
}
